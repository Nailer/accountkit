# Which chain the Clubhouse API reads. testnet uses our deployment of the HoS contracts (see DEPLOYMENT.md).
NETWORK=testnet
# Only names under this TLA count as memberships. Leave empty on mainnet to accept any verified House of Stake name.
CLUB_TLA=akclub.testnet
# Optional: RPC endpoints, comma-separated, tried in order.
# RPC_URLS=https://rpc.testnet.fastnear.com,https://rpc.testnet.near.org
PORT=8787

# --- Demo accounts for the live run and the e2e scripts ---------------------------
# `pnpm demo:bootstrap` fills these in with fresh testnet accounts and their keys.
# Keys are read from NEAR_CREDENTIALS_DIR/testnet/<account>.json (default ~/.near-credentials).
# NEAR_CREDENTIALS_DIR=
# DEMO_NAME=alice-member.akclub.testnet
# DEMO_A=ak-alice.testnet
# DEMO_B=ak-bob.testnet
# AGENT_ACCOUNT=ak-agent.testnet
# AGENT_APPROVED=ak-shop.testnet
# AGENT_STRANGER=akclub.testnet

# --- Serving -----------------------------------------------------------------------
# Interface to listen on. 127.0.0.1 keeps the API (which can sign testnet transactions) on this machine.
# HOST=127.0.0.1
# Extra browser origins allowed to POST, comma-separated (localhost is always allowed).
# ALLOWED_ORIGINS=https://clubhouse.example
# 32+ characters: keeps sign-ins valid across API restarts. Default: random per process.
# SESSION_SECRET=
# 1 to mark the session cookie Secure, when served over HTTPS.
# COOKIE_SECURE=0
# 0 to turn off the one-line-per-request log.
# LOG_REQUESTS=1
