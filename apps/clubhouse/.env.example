# Which chain the Clubhouse API reads. testnet uses our deployment of the HoS contracts (see DEPLOYMENT.md).
NETWORK=testnet
# Only names under this TLA count as memberships. Leave empty on mainnet to accept any verified House of Stake name.
CLUB_TLA=akclub.testnet
# Optional: RPC endpoints, comma-separated.
# RPC_URLS=https://rpc.testnet.fastnear.com,https://rpc.testnet.near.org
# Optional agent demo. The account's key must be in ~/.near-credentials/testnet/<account>.json on the API machine.
# AGENT_ACCOUNT=ak-agent.testnet
# AGENT_APPROVED=ak-shop.testnet
# AGENT_STRANGER=akclub.testnet
PORT=8787
