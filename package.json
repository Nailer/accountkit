{
  "name": "accountkit-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "AccountKit: a TypeScript SDK for House of Stake Top Level Accounts on NEAR, plus the Clubhouse demo app.",
  "license": "MIT",
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @accountkit/sdk build && pnpm --filter clubhouse dev",
    "test:live": "pnpm --filter @accountkit/sdk test:live",
    "demo:bootstrap": "pnpm --filter @accountkit/sdk build && pnpm --filter clubhouse exec tsx scripts/demo-bootstrap.ts",
    "demo:status": "pnpm --filter clubhouse exec tsx scripts/demo-status.ts",
    "e2e:transfer": "pnpm --filter clubhouse exec tsx scripts/e2e-transfer.ts",
    "e2e:server": "pnpm --filter clubhouse exec tsx scripts/e2e-server.ts",
    "e2e:agent": "pnpm --filter clubhouse exec tsx scripts/e2e-agent.ts",
    "e2e:attack": "pnpm --filter clubhouse exec tsx scripts/e2e-attack.ts",
    "e2e:all": "pnpm demo:status && pnpm e2e:transfer && pnpm e2e:agent && pnpm e2e:attack",
    "lint": "biome lint ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4"
  }
}
